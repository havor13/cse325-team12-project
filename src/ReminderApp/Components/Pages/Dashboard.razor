@page "/dashboard"
@attribute [Authorize]
@inject CurrentUserService Users
@inject TaskService TaskSvc
@inject AuthenticationStateProvider Auth

<PageTitle>Dashboard</PageTitle>
<h1>Dashboard</h1>

@if (user is null)
{
    <p>Loading…</p>
}
else
{
    var level = LevelService.GetLevel(user.Points);
    var next = LevelService.GetNext(user.Points);

    if (!string.IsNullOrEmpty(quote))
    {
        <blockquote class="quote">“@quote”</blockquote>
    }

    <section class="card">
        <h2>@level.Badge Level @level.Number: @level.Title</h2>
        <p>@user.Points points @(next is null ? "· max level reached" : $"· {next.MinPoints - user.Points} to {next.Title} {next.Badge}")</p>
        <div class="bar"><div class="fill" style="width:@(LevelService.ProgressToNext(user.Points).ToString("0.#"))%"></div></div>
        <details>
            <summary>Level milestones</summary>
            <ul>
                @foreach (var l in LevelService.Levels)
                {
                    <li>@l.Badge @l.Title: @l.MinPoints points @(l.Number == level.Number ? "(you are here)" : "")</li>
                }
            </ul>
        </details>
    </section>

    <div class="stats">
        <div class="card stat"><strong>@upcoming.Count</strong><span>Active</span></div>
        <div class="card stat"><strong>@completedCount</strong><span>Completed</span></div>
        <div class="card stat"><strong>@missedCount</strong><span>Missed</span></div>
    </div>

    <section class="card">
        <h2>Due soon (next 3 days)</h2>
        @if (dueSoon.Count == 0)
        {
            <p>Nothing due soon. 🎉</p>
        }
        else
        {
            <ul>
                @foreach (var t in dueSoon)
                {
                    <li>
                        <a href="tasks/@t.Id">@t.Title</a>
                        <DueBadge Item="t" />
                        · due @t.DueOn.ToString("ddd d MMM") · @t.ProgressPercent.ToString("0")% done
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card">
        <h2>@today.ToString("MMMM yyyy")</h2>
        @* TODO (feature 6): swap this built-in grid for the chosen Calendar API/component if the team picks one. *@
        <div class="cal">
            @foreach (var d in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
            {
                <div class="cal-head">@d</div>
            }
            @for (var i = 0; i < LeadingBlanks; i++)
            {
                <div class="cal-cell empty"></div>
            }
            @for (var day = 1; day <= DateTime.DaysInMonth(today.Year, today.Month); day++)
            {
                var date = new DateOnly(today.Year, today.Month, day);
                var due = upcoming.Where(t => t.DueOn == date).ToList();
                <div class="cal-cell @(date == today ? "today" : "")" title="@string.Join(", ", due.Select(t => t.Title))">
                    <span>@day</span>
                    @if (due.Count > 0)
                    {
                        <span class="dot">@due.Count</span>
                    }
                </div>
            }
        </div>
        @if (upcoming.Count == 0)
        {
            <p>No upcoming due dates.</p>
        }
    </section>
}

@code {
    private AppUser? user;
    private string? quote;
    private DateOnly today = DateOnly.FromDateTime(DateTime.UtcNow);
    private List<TaskItem> dueSoon = new();
    private List<TaskItem> upcoming = new();
    private int completedCount, missedCount;

    // Monday-first grid: how many empty cells before the 1st of the month.
    private int LeadingBlanks => ((int)new DateOnly(today.Year, today.Month, 1).DayOfWeek + 6) % 7;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await Auth.GetAuthenticationStateAsync()).User;
        quote = principal.FindFirst("quote")?.Value;

        user = await Users.GetAsync();
        if (user is null) return;

        await TaskSvc.SweepMissedAsync(user.Id);   // apply penalties for overdue tasks
        user = await Users.GetAsync();             // reload points

        var all = await TaskSvc.GetAllAsync(user!.Id);
        upcoming = all.Where(t => t.Status == TaskState.Pending).ToList();
        dueSoon = upcoming.Where(t => t.DueOn <= today.AddDays(3)).ToList();
        completedCount = all.Count(t => t.Status == TaskState.Completed);
        missedCount = all.Count(t => t.Status == TaskState.Missed);
    }
}
